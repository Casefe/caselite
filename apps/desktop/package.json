{
  "name": "@caselite/desktop",
  "productName": "CaseLite",
  "version": "0.0.0",
  "private": true,
  "description": "CaseLite desktop engineering baseline",
  "main": ".webpack/main/index.cjs",
  "scripts": {
    "dev": "electron-forge start",
    "typecheck": "tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.preload.json && tsc --noEmit -p tsconfig.renderer.json",
    "package": "electron-forge package --platform=darwin --arch=arm64"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/plugin-fuses": "8.0.1",
    "@electron-forge/plugin-webpack": "8.0.1",
    "@electron/fuses": "2.1.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "45.1.0",
    "ts-loader": "9.6.2",
    "typescript": "6.0.3",
    "webpack": "5.112.2"
  }
}
